{
  "name": "beneficios-formis",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Gestão local de benefícios Formis e Instrulabor",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n API,WEB,DESKTOP -c cyan,green,yellow \"npm:dev:server\" \"npm:dev:client\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:4317/api/health && electron .\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js",
    "desktop:pack": "npm run build && electron-builder --win nsis",
    "desktop:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": { "cors": "^2.8.5", "dotenv": "^16.4.7", "express": "^4.21.2", "mongoose": "^8.9.5" },
  "devDependencies": { "concurrently": "^9.2.1", "electron": "^37.2.6", "electron-builder": "^26.0.12", "wait-on": "^8.0.3" },
  "build": {
    "appId": "br.com.formis.beneficios",
    "productName": "Beneficios Formis",
    "asar": true,
    "files": ["electron/**/*", "client/dist/**/*", "server/src/**/*", "assets/**/*", "package.json", "node_modules/**/*"],
    "extraMetadata": { "main": "electron/main.cjs" },
    "directories": { "output": "dist-electron" },
    "win": { "icon": "assets/icon.ico", "target": ["nsis"], "artifactName": "Beneficios-Formis-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  },
  "allowScripts": { "electron@37.10.3": true, "electron-winstaller@5.4.0": true }
}
